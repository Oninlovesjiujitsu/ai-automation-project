{
  "name": "Support Routing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escalate",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "7",
      "name": "Escalation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [600, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/process-ticket",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "ticket_text",
              "value": "={{ $json.body.ticket_text }}"
            },
            {
              "name": "customer_name",
              "value": "={{ $json.body.customer_name }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Evaluate Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "dataType": "boolean",
        "value1": "={{ $json.evaluation.passed === true && !['angry', 'frustrated'].includes($json.sentiment) }}",
        "rules": {
          "rules": [
            {
              "value2": false,
              "output": 0
            },
            {
              "value2": true,
              "output": 1
            }
          ]
        }
      },
      "id": "3",
      "name": "Passed Evaluation?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=🚨 *Escalation Required* 🚨\n\n*Ticket:* {{ $json.body.ticket_text || $('Webhook').item.json.body.ticket_text }}\n*Draft:* {{ $json.body.draft || $json.draft }}\n*Reason:* {{ $json.body.evaluation?.reason || $json.evaluation.reason }}"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Slack Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [800, 100]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "5",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 500]
    },
    {
      "parameters": {},
      "id": "6",
      "name": "Send Auto-Reply Email",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [800, 500]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Evaluate Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escalation Webhook": {
      "main": [
        [
          {
            "node": "Slack Escalation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Ticket": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond to Webhook": {
      "main": [
        [
          {
            "node": "Passed Evaluation?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Passed Evaluation?": {
      "main": [
        [
          {
            "node": "Slack Escalation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Auto-Reply Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
